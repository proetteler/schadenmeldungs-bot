      },
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        496,
        240
      ],
      "id": "8e7e269d-a592-4334-82bf-805213916365",
      "name": "Response Format"
    },
    {
      "parameters": {
        "jsCode": "// Erlaubte Werte für status. Alles andere wird sicherheitshalber zur Übergabe.\nconst ERLAUBT = ['sammeln', 'bestaetigen', 'abgeschlossen', 'uebergabe'];\nconst sessionId = $('Bot Core Input').first().json.sessionId;\n\nreturn $input.all().map(item => {\n  const o = item.json.output ?? {};\n  const gueltig = ERLAUBT.includes(o.status);\n\n  return {\n    json: {\n      sessionId,\n      antwort: o.antwort ?? '',\n      status: gueltig ? o.status : 'uebergabe',\n      slots: o.slots ?? {},\n      uebergabe_grund: gueltig ? (o.uebergabe_grund ?? '') : `Ungültiger Status vom Modell: ${o.status}`,\n    },\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        688,
        -96
      ],
      "id": "eba7bb8e-a266-4965-b24c-9c9afab2b15c",
